#!/bin/sh
set -eu
ORBIT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mkdir -p "$HOME/.local/bin" "$HOME/.local/share/applications"
ln -sfn "$ORBIT_ROOT/scripts/orbit" "$HOME/.local/bin/orbit"
cat > "$HOME/.local/share/applications/dev.orbit.Converter.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Orbit
Comment=Local radial file converter
Exec="$HOME/.local/bin/orbit" %F
Icon=document-save-as
Terminal=false
Categories=Utility;Graphics;
MimeType=image/png;image/jpeg;image/webp;application/pdf;audio/mpeg;video/mp4;
StartupNotify=false
EOF
printf 'Installed Orbit. Launch with: orbit\n'
